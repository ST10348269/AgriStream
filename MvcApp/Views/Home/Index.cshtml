@model List<Shared.Data.Entities.Device>
@{
    ViewData["Title"] = "AgriStream";
}

<div class="bg-success text-white text-center py-5">
    <div class="container">
        <h1 class="display-4 fw-bold">AgriStream</h1>
        <p class="lead">Smart Monitoring for Commercial Farms</p>
        <p>Real-time soil sensors • Drone imagery • Automated irrigation</p>
        <a href="/Farm/Upload" class="btn btn-light btn-lg mt-2">Upload Drone Image</a>
    </div>
</div>

<div class="container mt-5">
    <h2 class="mb-4">Field Devices</h2>
    <div class="row">
        @foreach (var device in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card shadow">
                    <div class="card-body">
                        <h5 class="card-title">@device.Name</h5>
                        <p class="text-muted">@device.DeviceId</p>
                        <span class="badge bg-@(device.Status == "Idle" ? "secondary" : "success") fs-6">@device.Status</span>
                        <form asp-controller="Farm" asp-action="TriggerIrrigation" method="post" class="mt-3">
                            <input type="hidden" name="deviceId" value="@device.DeviceId" />
                            <button type="submit" class="btn btn-primary">Trigger Irrigation</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>